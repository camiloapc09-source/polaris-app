# Neon PostgreSQL
# Obtenlo en: https://console.neon.tech → tu proyecto → Connection string (Pooled)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL — Direct (sin pooler, para Prisma migrations)
# Obtenlo en: https://console.neon.tech → tu proyecto → Connection string (Direct)
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth — genera un secreto seguro con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de tu app en Render (ej: https://polaris-app.onrender.com)
NEXTAUTH_URL="https://tu-app.onrender.com"
